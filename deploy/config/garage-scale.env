# Garage-backed durable scale profile.
#
# This file is intentionally non-secret. Runtime secrets and endpoints remain in
# deploy/chaos/garage.env or the caller environment:
#   FJORD_PG_URL
#   FJORD_GARAGE_SECRET
#   FJORD_GARAGE_ENDPOINT
#   FJORD_GARAGE_BUCKET
#   FJORD_GARAGE_KEY_ID

records=100000000
partitions=12
record_size=1024
in_flight=300000
consume_deadline_secs=14400

# Object-log flush policy. These defaults target large Garage objects instead
# of low-latency tiny writes.
flush_linger_ms=30000
flush_max_bytes=134217728
flush_inflight=16
flush_max_buffered_bytes=4294967296
object_log_runtime_threads=16
disable_payload_signing=1
s3_range_fallback=1
s3_multipart_threshold_bytes=16777216
s3_multipart_part_bytes=8388608

# rdkafka producer policy. Multiple producers and larger client batches keep
# the broker/flush buffer fed while Garage PUTs are in flight.
producer_count=12
producer_linger_ms=1000
producer_batch_size=16777216
producer_message_max_bytes=67108864
producer_queue_messages=300000
producer_queue_kbytes=524288
producer_max_inflight_requests=1000
producer_message_timeout_ms=300000

fault_profile=none
nice_level=10
evidence_root=/tank/home/erik/fjord-evidence
